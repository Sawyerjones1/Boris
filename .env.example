OPENAI_API_KEY=
# Local: postgresql://user:password@127.0.0.1:5432/boris (no TLS needed).
# Hosted: use the provider URL with sslmode=verify-full (verified TLS).
DATABASE_URL=

PORT=3000
# Loopback by default. Set 0.0.0.0 only for deliberate remote access behind authentication.
HOST=127.0.0.1
APP_TIMEZONE=America/New_York

OPENWEATHERMAP_API_KEY=
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNITS=imperial

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional Telegram overrides. TELEGRAM_CHAT_ID is a fallback for
# TELEGRAM_ALLOWED_CHAT_ID; TELEGRAM_USER_ID routes inbound messages to a
# specific user ID instead of the one in config.json.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional fixed end date for deterministic demo screenshots (YYYY-MM-DD).
DEMO_END_DATE=
